		"@tanstack/react-query": "^5.104.1",
		"drizzle-orm": "^0.45.3",
		"hono": "^4.13.13",
		"leaflet": "1.9.4",
		"lucide-react": "^1.52.0",
		"motion": "^14.0.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.89.0",
		"react-router": "^8.4.0",
